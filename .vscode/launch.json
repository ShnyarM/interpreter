{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb)",  // Name of the configuration
            "type": "cppdbg",        // Specifies that this is for C++
            "request": "launch",     // Launch the program
            "program": "${workspaceFolder}/parse_dbg",  // Path to your compiled executable
            "args": ["p2.t"],              // Arguments to pass to your program
            "stopAtEntry": false,    // Whether to stop at the entry point of the program
            "cwd": "${workspaceFolder}",  // Current working directory
            "environment": [],       // Environment variables
            "externalConsole": false, // Use VSCode's integrated console for debugging
            "MIMode": "gdb",         // Specify the debugger as GDB
            "miDebuggerPath": "/usr/bin/gdb",  // Path to GDB (adjust this if needed)
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "internalConsoleOptions": "openOnSessionStart"
        },
    ]
}